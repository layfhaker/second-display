# ---- Build outputs (regenerated by the build) ----
**/bin/
**/obj/
**/build/
**/.gradle/
**/.kotlin/
**/.idea/
target/
.vs/
*.user
*.suo
local.properties*

# ---- Releases: binaries go to GitHub Releases, not into git ----
# Keep releases/README.md (the release index); ignore everything else in the folder.
releases/*
!releases/README.md

# ---- Logs & scratch ----
*.log
.build/
tmp-build/
host/build_out*/
build_out*/

# ---- Test captures / media ----
*.h265
*.apk

# ---- Local machine / secrets ----
.env

# ---- Editor / OS / agent tooling ----
.vscode/
*.swp
.DS_Store
Thumbs.db
.commandcode/
.claude/
.agents/
session-*.md
