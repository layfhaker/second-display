extern Bool client_alive;
extern Bool SockReadAll(I64 sock, U8 *buf, I64 n);
extern I64  SockWrite(I64 sock, U8 *buf, I64 n);
extern U0   PktWrite32(U8 *p, U32 v);
extern U32  PktRead32(U8 *p);

I64 touch_injected_count = 0;
I64 key_injected_count = 0;

U0 InjectTouch(U8 action, F32 x, F32 y)
{
    INPUT inp;
    MemSet(&inp, 0, sizeof(inp));
    inp.type = INPUT_MOUSE;

    I32 abs_x = originX + (I32)(x * capW);
    I32 abs_y = originY + (I32)(y * capH);

    inp.mi.dx = (LONG)((I64)abs_x * 65535 / 3840);
    inp.mi.dy = (LONG)((I64)abs_y * 65535 / 1280);
    inp.mi.dwFlags = MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_VIRTUALDESK | MOUSEEVENTF_MOVE;

    if (action == 0) {
        inp.mi.dwFlags |= MOUSEEVENTF_LEFTDOWN;
    } else if (action == 2) {
        inp.mi.dwFlags |= MOUSEEVENTF_LEFTUP;
    }

    SendInput(1, &inp, sizeof(INPUT));

    touch_injected_count++;
    if (touch_injected_count <= 5 || touch_injected_count % 50 == 0) {
        "Touch event #%lld injected: action=%d pos=(%.3f, %.3f)\n", touch_injected_count, action, x, y;
    }
}

U0 InjectKey(U8 action, U16 key_code, U32 meta_state, U16 scan_code)
{
    INPUT inp;
    MemSet(&inp, 0, sizeof(inp));
    inp.type = INPUT_KEYBOARD;

    WORD vk = (WORD)key_code;
    WORD sc = (WORD)scan_code;
    if (sc == 0) sc = (WORD)MapVirtualKeyW(vk, MAPVK_VK_TO_VSC);

    inp.ki.wVk = vk;
    inp.ki.wScan = sc;
    if (sc != 0) inp.ki.dwFlags |= KEYEVENTF_SCANCODE;
    if (action == 1) inp.ki.dwFlags |= KEYEVENTF_KEYUP;

    SendInput(1, &inp, sizeof(INPUT));

    key_injected_count++;
    if (key_injected_count <= 5 || key_injected_count % 20 == 0) {
        "Key event #%lld injected: action=%d code=%u scan=%u\n", key_injected_count, action, key_code, scan_code;
    }
}

HDC hdcCurMem = NULL;
HBITMAP hbmCurDib = NULL;
HBITMAP hbmCurOld = NULL;
U32 *pCurDibBits = NULL;

U0 InitCursorRenderer()
{
    if (hdcCurMem) return;
    BITMAPINFO bmi;
    MemSet(&bmi, 0, sizeof(bmi));
    bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
    bmi.bmiHeader.biWidth = 32;
    bmi.bmiHeader.biHeight = -32;
    bmi.bmiHeader.biPlanes = 1;
    bmi.bmiHeader.biBitCount = 32;
    bmi.bmiHeader.biCompression = BI_RGB;

    HDC hdcScreen = GetDC(NULL);
    hdcCurMem = CreateCompatibleDC(hdcScreen);
    hbmCurDib = CreateDIBSection(hdcCurMem, &bmi, DIB_RGB_COLORS, (void**)&pCurDibBits, NULL, 0);
    hbmCurOld = (HBITMAP)SelectObject(hdcCurMem, hbmCurDib);
    ReleaseDC(NULL, hdcScreen);
}

U0 SendCursorPacket(I64 client_sock)
{
    if (!client_alive) return;

    CURSORINFO ci;
    MemSet(&ci, 0, sizeof(ci));
    ci.cbSize = sizeof(CURSORINFO);

    I32 rel_x = 0;
    I32 rel_y = 0;
    U8 visible = 0;
    I32 cur_w = 32;
    I32 cur_h = 32;
    static HCURSOR last_hcur = NULL;
    static I32 last_x = -9999;
    static I32 last_y = -9999;
    static U8 last_vis = 255;
    static Bool client_has_shape = FALSE;

    POINT pt;
    if (GetCursorPos(&pt)) {
        rel_x = pt.x - originX;
        rel_y = pt.y - originY;
        if (rel_x >= 0 && rel_x < capW && rel_y >= 0 && rel_y < capH) {
            visible = 1;
        }
    }

    if (GetCursorInfo(&ci)) {
        if (ci.flags & CURSOR_SHOWING) {
            rel_x = ci.ptScreenPos.x - originX;
            rel_y = ci.ptScreenPos.y - originY;
            if (rel_x >= 0 && rel_x < capW && rel_y >= 0 && rel_y < capH) {
                visible = 1;
            }
        }
        if (ci.hCursor != last_hcur && ci.hCursor != NULL) {
            last_hcur = ci.hCursor;
            client_has_shape = FALSE;
        }
    }

    Bool need_shape = (!client_has_shape && visible != 0);

    if (!need_shape && rel_x == last_x && rel_y == last_y && visible == last_vis)
        return;

    last_x = rel_x;
    last_y = rel_y;
    last_vis = visible;

    I64 bgra_len = 0;
    if (need_shape) {
        InitCursorRenderer();
        HCURSOR hToDraw = last_hcur;
        if (!hToDraw) {
            hToDraw = LoadCursorA(NULL, (LPCSTR)32512); // IDC_ARROW
        }

        U32 bufBlack[32 * 32];
        U32 bufWhite[32 * 32];

        // Pass 1: Render onto pure black background
        MemSet(pCurDibBits, 0, 32 * 32 * 4);
        DrawIconEx(hdcCurMem, 0, 0, hToDraw, 32, 32, 0, NULL, DI_NORMAL);
        MemCpy(bufBlack, pCurDibBits, 32 * 32 * 4);

        // Pass 2: Render onto pure white background
        I64 pxi;
        for (pxi = 0; pxi < 32 * 32; pxi++) pCurDibBits[pxi] = 0x00FFFFFF;
        DrawIconEx(hdcCurMem, 0, 0, hToDraw, 32, 32, 0, NULL, DI_NORMAL);
        MemCpy(bufWhite, pCurDibBits, 32 * 32 * 4);

        // Combine passes into true 32-bit ARGB with crisp outline and interior
        for (pxi = 0; pxi < 32 * 32; pxi++) {
            U32 b = bufBlack[pxi] & 0x00FFFFFF;
            U32 w = bufWhite[pxi] & 0x00FFFFFF;
            if (b == w) {
                // Opaque pixel (white interior or black border)
                pCurDibBits[pxi] = 0xFF000000 | b;
            } else if (b == 0 && w == 0x00FFFFFF) {
                // Transparent background
                pCurDibBits[pxi] = 0x00000000;
            } else {
                // Inverted or anti-aliased edge: draw as opaque dark border
                pCurDibBits[pxi] = 0xFF000000 | b;
            }
        }

        bgra_len = 32 * 32 * 4;
        client_has_shape = TRUE;
    }

    U8 cur_hdr[22];
    cur_hdr[0] = PKT_CURSOR;
    PktWrite32(cur_hdr + 1, (U32)(17 + bgra_len));
    cur_hdr[5] = visible;
    PktWrite32(cur_hdr + 6, (U32)rel_x);
    PktWrite32(cur_hdr + 10, (U32)rel_y);
    PktWrite32(cur_hdr + 14, (U32)cur_w);
    PktWrite32(cur_hdr + 18, (U32)cur_h);

    if (SockWrite(client_sock, cur_hdr, 22) <= 0) {
        client_alive = FALSE;
        return;
    }

    if (bgra_len > 0) {
        if (SockWrite(client_sock, (U8*)pCurDibBits, bgra_len) <= 0) {
            client_alive = FALSE;
            return;
        }
    }
}

DWORD WINAPI InputThreadProc(LPVOID lpParam)
{
    I64 client_sock = (I64)lpParam;
    U8 hdr[5];
    U8 pay[1024];

    while (client_alive) {
        if (!SockReadAll(client_sock, hdr, 5))
            break;

        U8 type = hdr[0];
        U32 len = PktRead32(hdr + 1);
        if (len > 1024)
            break;

        if (len > 0) {
            if (!SockReadAll(client_sock, pay, len))
                break;
        }

        if (type == PKT_TOUCH) {
            if (len >= 10) {
                U8 action = pay[0];
                U8 pointer_id = pay[1];
                F32 x = *(F32*)(pay + 2);
                F32 y = *(F32*)(pay + 6);
                InjectTouch(action, x, y);
            }
        } else if (type == PKT_KEY) {
            if (len >= 7) {
                U8 action = pay[0];
                U16 key_code = (U16)(pay[1] | (pay[2] << 8));
                U32 meta_state = (U32)(pay[3] | (pay[4] << 8) | (pay[5] << 16) | (pay[6] << 24));
                U16 scan_code = 0;
                if (len >= 9) {
                    scan_code = (U16)(pay[7] | (pay[8] << 8));
                }
                InjectKey(action, key_code, meta_state, scan_code);
            }
        }
    }

    client_alive = FALSE;
    return 0;
}
